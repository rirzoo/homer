# The TUI against the demo server. Run from the repo root: demo/up.sh /tmp/maya && vhs demo/tui.tape
Output media/tui.gif
Set Shell bash
Set FontSize 16
Set Width 1400
Set Height 760
Set Padding 20
Set TypingSpeed 45ms
Hide
Type 'export HOME=/tmp/maya PATH=/tmp/maya/bin:$PATH EDITOR=vi PS1="$ " && cd && clear'
Enter
Show
Type "homer"
Sleep 400ms
Enter
Sleep 3s
Screenshot media/tui.png
Type "j"
Sleep 2s
Enter
Sleep 3s
Type "q"
Sleep 1s
Type "r"
Sleep 1.5s
Type "iThe error screens are in the deck now, slides 14 to 17."
Sleep 500ms
Escape
Type ":wq"
Enter
Sleep 3s
Ctrl+S
Sleep 4s
Hide
Sleep 8s
Show
Sleep 3s
Type "f"
Sleep 1.5s
Type "jjjj"
Sleep 1s
Enter
Sleep 1s
Type "jj"
Sleep 800ms
Enter
Sleep 3.5s
Ctrl+T
Sleep 2s
Type "k"
Sleep 1.2s
Type "k"
Sleep 1.2s
Type "k"
Sleep 1.5s
Screenshot media/tui-themes.png
Type "k"
Sleep 1.5s
Escape
Sleep 1s
Type "q"
Sleep 500ms
